# Claude intent extraction (optional; offline parser is used when omitted)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# If a Claude call fails, fail closed by default. Set true only for demos where
# a heuristic fallback is preferable to stopping.
POLICYGATE_ALLOW_AI_FALLBACK=false

# Foxit PDF Services / MCP server credentials
FOXIT_CLOUD_API_HOST=https://na1.fusion.foxit.com/pdf-services
FOXIT_CLOUD_API_CLIENT_ID=
FOXIT_CLOUD_API_CLIENT_SECRET=

# Foxit eSign credentials (separate account / portal)
FOXIT_ESIGN_BASE_URL=https://na1.foxitesign.foxit.com
FOXIT_ESIGN_CLIENT_ID=
FOXIT_ESIGN_CLIENT_SECRET=
FOXIT_ESIGN_WEBHOOK_SECRET=
# Routing is explicit. Keep false while developing to avoid sending real emails.
# Set true for the live demo to send the Foxit invitation to the named approver.
POLICYGATE_FOXIT_SEND_NOW=false

# true = request a short-lived embedded HUMAN signing session in the response.
# The agent still never signs. This can be used instead of an email invitation.
POLICYGATE_EMBEDDED_SIGNING=false

# true = generate real Terraform and run `terraform init/validate/plan`
# against your configured AWS provider before building the approval PDF,
# binding the plan file's SHA-256 into the document a human signs. Requires
# terraform installed and working AWS credentials — no mock mode. Keep false
# until you're ready to demo this; for the live demo, set true.
POLICYGATE_INCLUDE_TERRAFORM_PLAN=false

# true = allow `python -m policygate.provision ... --apply` to actually run
# `terraform apply` and create real, billable AWS resources. This never
# re-plans — it only applies the exact plan file a human already approved.
# Keep false except for the deliberate moment you're demonstrating live
# provisioning, and set it back to false immediately after.
POLICYGATE_ALLOW_APPLY=false

# Fail-closed recording mode. Requires live Claude with AI fallback disabled,
# Foxit PDF/MCP + eSign credentials, exactly one human signing route (email or
# embedded), and a real Terraform plan before the run. Configuration proves
# credentials are present; still capture a genuine MCP tool call in the video.
POLICYGATE_SUBMISSION_MODE=false

# Destructive cleanup is separately gated. To destroy a live demo DB, set this
# to true only for cleanup AND pass --confirm-request-id with the exact request.
POLICYGATE_ALLOW_DESTROY=false
